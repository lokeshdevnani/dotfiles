# oh-my-zsh plugins. Every plugin adds shell startup time; history, jump-to-directory and
# fuzzy search come from atuin / zoxide / fzf (see tools.zsh).
plugins=(
  git                  # git aliases (gst, gco, ...)
  docker               # docker completions
  zsh-autosuggestions  # cloned by install.sh
  alias-tips           # reminds you of aliases you have; cloned by install.sh
  colored-man-pages
  macos
)
